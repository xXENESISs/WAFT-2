{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waft.example/schema/region-overrides.schema.json",
  "title": "WAFT Adventure persistent region overrides",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "regionId", "operations"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "regionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/move"
          },
          {
            "$ref": "#/$defs/scale"
          },
          {
            "$ref": "#/$defs/remove"
          },
          {
            "$ref": "#/$defs/customModel"
          },
          {
            "$ref": "#/$defs/localDensity"
          },
          {
            "$ref": "#/$defs/protectArea"
          }
        ]
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetType", "targetId"],
      "properties": {
        "targetType": {
          "enum": ["settlement", "building", "landmark", "vegetation-zone", "fauna-zone", "route"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "targetType", "targetId", "space", "offset"],
      "properties": {
        "op": {
          "const": "move"
        },
        "targetType": {
          "enum": ["settlement", "building", "landmark", "vegetation-zone", "fauna-zone", "route"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "space": {
          "enum": ["local-units", "geographic-km"]
        },
        "offset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "z"],
          "properties": {
            "x": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "targetType", "targetId", "value"],
      "properties": {
        "op": {
          "const": "scale"
        },
        "targetType": {
          "enum": ["building", "landmark"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "verticalValue": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        }
      }
    },
    "remove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "targetType", "targetId"],
      "properties": {
        "op": {
          "const": "remove"
        },
        "targetType": {
          "enum": ["settlement", "building", "landmark", "vegetation-zone", "fauna-zone", "route"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "customModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "targetType", "targetId", "assetId"],
      "properties": {
        "op": {
          "const": "custom-model"
        },
        "targetType": {
          "enum": ["building", "landmark"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "assetId": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "localDensity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "layer", "center", "radiusKm", "multiplier"],
      "properties": {
        "op": {
          "const": "local-density"
        },
        "layer": {
          "enum": ["buildings", "vegetation", "fauna"]
        },
        "center": {
          "$ref": "#/$defs/geoPoint"
        },
        "radiusKm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "protectArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "id", "center", "radiusKm", "exclude"],
      "properties": {
        "op": {
          "const": "protect-area"
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "center": {
          "$ref": "#/$defs/geoPoint"
        },
        "radiusKm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["buildings", "vegetation", "fauna", "roads", "landmarks"]
          }
        }
      }
    },
    "geoPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lon", "lat"],
      "properties": {
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    }
  }
}
